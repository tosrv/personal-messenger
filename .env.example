# Copy to .env and fill in. Never commit .env.
APP_ENV=development
PORT=8080

POSTGRES_USER=messenger
POSTGRES_PASSWORD=messenger
POSTGRES_DB=messenger
# Used when running the server outside Docker (go run ./cmd/api)
DATABASE_URL=postgres://messenger:messenger@localhost:5433/messenger?sslmode=disable
TEST_DATABASE_URL=postgres://messenger:messenger@localhost:5433/messenger_test?sslmode=disable

APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth (Milestone 2) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:5173/api/v1/auth/callback

# At least 32 random chars in production: openssl rand -base64 48
SESSION_SECRET=

# Production only
DOMAIN=chat.example.com

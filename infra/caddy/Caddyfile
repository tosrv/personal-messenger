{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Same-origin scripts, styles and API/WebSocket only; Google avatars allowed.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self'; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy server:8080
	}
	handle /ws {
		reverse_proxy server:8080
	}
	handle {
		reverse_proxy web:80
	}
}
